---
import Base from '../layouts/Base.astro';import Cards from '../components/Cards.astro';import {categories,tools} from '../data';import {getCollection} from 'astro:content';import {info} from '../info';export function getStaticPaths(){return [...Object.keys(categories),...Object.keys(info)].map(slug=>({params:{slug}}));}const slug=Astro.params.slug!;const category=categories[slug];const guides=category?(await getCollection('guias')).filter(g=>g.data.category===slug):[];const relevant=tools.filter(t=>t.category===slug);const page=info[slug];
---
<Base title={category||page.title}><div class="crumb"><a href="/">Inicio</a> / {category||page.title}</div>{category?<><div class="page-intro"><span class="eyebrow">Paso a paso, con claridad</span><h1>{category}</h1><p class="muted">{slug==='tramites'?'Los trámites se incorporarán en la segunda fase del proyecto. Mientras tanto, consulta las herramientas y los recursos oficiales.':'Herramientas y lecturas del Plan Maestro para entender tus próximos pasos.'}</p></div>{relevant.length>0&&<Cards items={relevant}/>}<section><h2>{guides.length?'Lecturas para revisar':'Recursos de consulta'}</h2>{guides.length?<div class="cards guides">{guides.map(g=><a class="card" href={'/guias/'+g.id+'/'}><span class="eyebrow">Borrador editorial</span><h3>{g.data.title}</h3><p>{g.data.description}</p><span>Leer guía →</span></a>)}</div>:<p>Para información sobre documentación tributaria, consulta <a href="https://www.irs.gov/es" target="_blank" rel="noopener noreferrer">el portal oficial del IRS en español</a>. También puedes <a href="/herramientas/">hacer tus cuentas con las calculadoras</a>.</p>}</section></>:<article class="prose"><h1>{page.title}</h1><div set:html={page.body}/></article>}</Base>
