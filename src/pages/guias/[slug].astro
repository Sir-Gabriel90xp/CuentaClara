---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';export async function getStaticPaths(){return (await getCollection('guias')).map(guide=>({params:{slug:guide.id},props:{guide}}));}const {guide}=Astro.props;const {Content}=await render(guide);const related=(await getCollection('guias')).filter(g=>g.id!==guide.id).slice(0,3);
---
<Base title={guide.data.title.length>44?guide.data.title.slice(0,41)+'…':guide.data.title} description={guide.data.description} noindex={guide.data.draft}><div class="crumb"><a href="/">Inicio</a> / <a href={'/'+guide.data.category+'/'}>{guide.data.category.replaceAll('-',' ')}</a> / Guía</div><article class="prose" data-pagefind-body><span class="eyebrow">Guía práctica · {guide.data.reading} min de lectura</span><h1>{guide.data.title}</h1><p class="muted">{guide.data.description}</p><div class="draft"><strong>Borrador para revisión editorial.</strong> Texto procedente del Plan Maestro. Sin revisor humano acreditado; no constituye asesoría. Fuentes de contraste consultadas el 16 de octubre de 2026.</div><p class="example">Autoría: {guide.data.author} · Revisión humana: pendiente</p><Content/><div class="sources"><h2>Fuentes para contrastar</h2><ul>{guide.data.sources.map(s=><li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name} ↗</a><br/><small>Consulta: {s.accessed}</small></li>)}</ul></div><div class="notice">Contenido educativo. No sustituye una evaluación profesional financiera, fiscal o legal de tu situación.</div><a class="button" href={guide.data.relatedTool}>Abrir la calculadora relacionada ↗</a><h2>Sigue leyendo</h2><ul>{related.map(g=><li><a href={'/guias/'+g.id+'/'}>{g.data.title}</a></li>)}</ul></article></Base>
