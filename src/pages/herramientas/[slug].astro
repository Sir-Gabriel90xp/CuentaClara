---
import Base from '../../layouts/Base.astro';import {tools} from '../../data';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}const {tool}=Astro.props;
const configs={
'costo-real-de-una-remesa':[['monto','Monto enviado (USD)',200,0.01],['tarifa','Tarifa (USD)',4,0],['ofrecido','Tipo de cambio ofrecido',58,0.0001],['referencia','Tipo de cambio de referencia',59,0.0001]],
'interes-de-tarjeta-de-credito':[['saldo','Saldo pendiente (USD)',1000,0.01],['apr','Tasa anual APR (%)',24,0],['pago','Pago mensual (USD)',100,0.01]],
'meta-de-ahorro':[['meta','Meta (USD)',5000,0.01],['aporte','Aporte mensual (USD)',100,0],['tasa','Tasa anual nominal (%)',0,0],['inicial','Saldo inicial (USD)',0,0]],
'presupuesto-50-30-20':[['ingreso','Ingreso neto mensual (USD)',2400,0.01],['envio','Remesa mensual (USD)',300,0],['p1','Necesidades (%)',50,0],['p2','Deseos (%)',30,0],['p3','Ahorro y deudas (%)',20,0]]};
const explanations={'costo-real-de-una-remesa':'El costo estimado suma la tarifa y el margen de cambio: monto × (1 − cambio ofrecido / referencia). La tarifa se paga aparte del monto enviado. No se incluyen impuestos ni cargos adicionales del receptor. Introduce tú la referencia; no consultamos cotizaciones en tiempo real.','interes-de-tarjeta-de-credito':'Usamos APR / 12 como tasa mensual, con saldo y pago constantes, sin nuevas compras ni comisiones. Simulamos cada mes y ajustamos el último pago para no sobreestimar intereses. Tu emisor puede calcular los intereses diariamente.','meta-de-ahorro':'Aplicamos la tasa anual nominal dividida entre 12, capitalizada mensualmente, y añadimos el aporte al final del mes. No incluye impuestos, comisiones ni inflación. Límite de simulación: 600 meses. No representa una rentabilidad garantizada.','presupuesto-50-30-20':'Primero restamos la remesa del ingreso neto. Después distribuimos el resto según tus porcentajes, que deben sumar 100. Es una regla orientativa que puedes adaptar a tu realidad.'};
---
<Base title={tool.title} description={tool.description}><div class="crumb"><a href="/">Inicio</a> / <a href="/herramientas/">Herramientas</a> / {tool.title}</div><div class="page-intro"><span class="eyebrow">Calculadora gratuita · Sin registro</span><h1>{tool.title}</h1><p class="muted">{tool.description}</p></div><div class="tool-grid"><form id="calculator" class="panel" data-tool={tool.slug}><h2 style="font-size:1.7rem;margin-top:0">Pon tus números</h2><p class="example">Ejemplo ilustrativo precargado. Modifica los valores para hacer tu cálculo.</p><div class="fields">{configs[tool.slug].map(([id,label,value,min])=><label for={String(id)}>{label}<input id={String(id)} name={String(id)} type="number" required min={min} max="1000000000000" step="any" value={value} aria-describedby="calc-error"/></label>)}</div><p id="calc-error" class="error" role="alert"></p><button type="submit">Calcular resultado ↗</button></form><div class="panel results" aria-live="polite" aria-atomic="true"><span class="eyebrow">Tus números, más claros</span><div id="result"><h2 style="font-size:1.9rem">Cada decisión empieza con una cuenta.</h2><p>Completa los campos y pulsa «Calcular resultado».</p></div><button type="button" class="secondary" id="csv" hidden>Descargar CSV</button><p style="font-size:12px;margin-top:25px">Estimación educativa; no es asesoría financiera.</p></div></div><article class="prose"><h2>Cómo hacemos el cálculo</h2><p>{explanations[tool.slug]}</p><h2>Preguntas frecuentes</h2><details><summary>¿Se guardan los datos que introduzco?</summary><p>No. Los valores se procesan en esta página, en tu navegador. No se transmiten ni se guardan.</p></details><details><summary>¿El resultado es una cotización o una promesa?</summary><p>No. Es una estimación matemática basada en tus entradas. Comprueba las condiciones reales de cada proveedor.</p></details><p><a href={'/'+tool.category+'/'}>Explorar esta categoría</a> · <a href="/metodologia/">Leer la metodología</a> · <a href="/herramientas/">Otras calculadoras</a></p></article></Base>
<script>
import {remesa,tarjeta,ahorro,presupuesto} from '../../tools/calculations';
const form=document.querySelector<HTMLFormElement>('#calculator')!;const result=document.querySelector('#result')!;const error=document.querySelector('#calc-error')!;const csv=document.querySelector<HTMLButtonElement>('#csv')!;let csvRows:string[][]=[];const fmt=(v:number)=>new Intl.NumberFormat('es',{maximumFractionDigits:2,minimumFractionDigits:2}).format(v);const money=(v:number)=>fmt(v)+' USD';
form.addEventListener('submit',e=>{e.preventDefault();error.textContent='';csv.hidden=true;try{const d=new FormData(form);const n=(key:string)=>Number(d.get(key));let rows:[string,string][]=[];let note='';switch(form.dataset.tool){case 'costo-real-de-una-remesa':{const r=remesa(n('monto'),n('tarifa'),n('ofrecido'),n('referencia'));rows=[['Monto recibido (moneda local)',fmt(r.recibido)],['Diferencia frente a referencia (moneda local)',fmt(r.diferencia)],['Costo por tipo de cambio',money(r.cambio)],['Costo total estimado',money(r.total)],['Porcentaje del monto enviado',fmt(r.porcentaje)+' %']];if(r.cambio<0)note='Tipo de cambio a tu favor: el cambio ofrecido supera tu referencia. Comprueba que ambas cotizaciones sean comparables.';break;}case 'interes-de-tarjeta-de-credito':{const r=tarjeta(n('saldo'),n('apr'),n('pago'));rows=[['Tiempo estimado',r.meses+' meses'],['Intereses estimados',money(r.interes)],['Último pago estimado',money(r.ultimo)]];break;}case 'meta-de-ahorro':{const r=ahorro(n('meta'),n('aporte'),n('tasa'),n('inicial'));const now=new Date();const date=new Date(now.getFullYear(),now.getMonth()+r.meses,1);rows=[['Tiempo estimado',r.meses+' meses'],['Mes estimado',date.toLocaleDateString('es',{month:'long',year:'numeric'})],['Total aportado',money(r.aportado)],['Saldo estimado',money(r.saldo)]];break;}default:{const r=presupuesto(n('ingreso'),n('envio'),n('p1'),n('p2'),n('p3'));rows=[['Disponible después de la remesa',money(r.base)],['Necesidades',money(r.necesidades)],['Deseos',money(r.deseos)],['Ahorro y deudas',money(r.ahorro)]];csvRows=[['Categoría','Monto USD'],['Remesa',String(n('envio'))],['Necesidades',String(r.necesidades)],['Deseos',String(r.deseos)],['Ahorro y deudas',String(r.ahorro)]];csv.hidden=false;}}
result.replaceChildren();const dl=document.createElement('dl');for(const [k,v] of rows){const dt=document.createElement('dt');dt.textContent=k;const dd=document.createElement('dd');dd.textContent=v;dl.append(dt,dd)}result.append(dl);if(note){const p=document.createElement('p');p.textContent=note;result.append(p)}}catch(err){error.textContent=(err as Error).message;result.textContent='Corrige los valores indicados para obtener un resultado.'}});
csv.addEventListener('click',()=>{let blob=new Blob(['\uFEFF'+csvRows.map(r=>r.map(v=>'"'+v.replaceAll('"','""')+'"').join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='cuenta-clara-presupuesto.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)});
</script>
